#!/usr/bin/env python3
"""
Global Intelligence — Zvec 向量存储模块
基于 Zvec v0.3.0 API（实测验证版）

API 关键规则（2026-04-17 实测）：
- 主键必须是 STRING 类型（int会报TypeError）
- doc.fields['key'] = value 设置字段（不能用 doc.set_xxx）
- doc.vectors['vec'] = np.ndarray 设置向量（np.float32）
- Collection.upsert([doc]) 插入，flush() 持久化
- Collection.query(vectors=[VectorQuery(field, id=None, vector=np.array)], topk=N, filter=...)
- Collection 无 close() 方法
- zvec.create_and_open() 会自动创建目录，不能自己提前 mkdir
- VectorQuery 传入 np.array 会有 bool 检查 bug，传 list 则正常

作者：伊迪丝·工部
"""

import os
import json
import uuid
import time
from datetime import datetime
from typing import Optional

try:
    import zvec
    import numpy as np
    ZVEC_AVAILABLE = True
except ImportError:
    ZVEC_AVAILABLE = False

# ============================================================
# 配置
# ============================================================

VEC_DIM = 1536  # OpenAI text-embedding-3-small / Qwen-Embedding 维度

# 集合路径固定在 skill 根目录下（而非相对于 scripts/）
SKILL_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA_DIR = os.path.join(SKILL_ROOT, 'data', 'vectors')
os.makedirs(DATA_DIR, exist_ok=True)

COLLECTION_NAME = 'global_intelligence'
COLLECTION_PATH = os.path.join(DATA_DIR, COLLECTION_NAME)

# ============================================================
# Schema 定义
# ============================================================

def _make_schema() -> 'zvec.CollectionSchema':
    return zvec.CollectionSchema(
        name=COLLECTION_NAME,
        fields=[
            zvec.FieldSchema('id',          zvec.DataType.STRING),   # 文档唯一ID
            zvec.FieldSchema('title',       zvec.DataType.STRING),   # 标题
            zvec.FieldSchema('topic',       zvec.DataType.STRING),   # 主题分类
            zvec.FieldSchema('priority',   zvec.DataType.STRING),   # 优先级：高/中/低
            zvec.FieldSchema('timestamp',  zvec.DataType.DOUBLE),   # 时间戳（秒）
            zvec.FieldSchema('summary',     zvec.DataType.STRING),   # 分析摘要
        ],
        vectors=[
            zvec.VectorSchema('embedding', zvec.DataType.VECTOR_FP32, VEC_DIM)
        ]
    )


# ============================================================
# 嵌入生成（多后端支持）
# ============================================================

def embed_text(text: str) -> Optional[list]:
    """
    生成文本嵌入向量。
    优先级：Zvec内置Qwen → DashScope → OpenAI → MLX本地 → 随机降级
    """
    text = text[:8000]  # 限制输入长度

    # 1. Zvec 内置 Qwen embedding（需要 DashScope API Key）
    if ZVEC_AVAILABLE:
        try:
            import zvec
            api_key = os.environ.get('DASHSCOPE_API_KEY')
            emb_fn = zvec.QwenDenseEmbedding(
                dimension=VEC_DIM,
                model='text-embedding-v4',
                api_key=api_key or ''
            )
            vec = np.array(emb_fn.execute([text])[0], dtype=np.float32)
            vec = vec / (np.linalg.norm(vec) + 1e-8)
            print('✅ [vector_store] 嵌入: Zvec-Qwen ✅')
            return vec.tolist()
        except Exception as e:
            pass  # 不打印，静默降级

    # 2. DashScope
    api_key = os.environ.get('DASHSCOPE_API_KEY')
    if api_key:
        try:
            import dashscope
            dashscope.api_key = api_key
            resp = dashscope.TextEmbedding.call(
                model=dashscope.TextEmbedding.Models.text_embedding_sts,
                input=text
            )
            if resp.status_code == 200:
                emb = resp.output['embeddings'][0]['embedding']
                print('✅ [vector_store] 嵌入: DashScope ✅')
                return emb[:VEC_DIM]
        except Exception:
            pass

    # 3. OpenAI
    api_key = os.environ.get('OPENAI_API_KEY')
    if api_key:
        try:
            import openai
            client = openai.OpenAI(api_key=api_key)
            resp = client.embeddings.create(
                model='text-embedding-3-small', input=text
            )
            print('✅ [vector_store] 嵌入: OpenAI ✅')
            return resp.data[0].embedding[:VEC_DIM]
        except Exception:
            pass

    # 4. 本地 MLX 后备
    mlx_script = os.path.expanduser(
        '~/.qclaw/workspace/skills/mlx-fallback/scripts/chat.py'
    )
    if os.path.exists(mlx_script):
        try:
            result = subprocess.run(
                ['python3', mlx_script, '--embed', text[:500]],
                capture_output=True, text=True, timeout=30,
                cwd=os.path.dirname(mlx_script)
            )
            if result.returncode == 0:
                import json as _json
                data = _json.loads(result.stdout.strip().split('\n')[-1])
                print('✅ [vector_store] 嵌入: MLX ✅')
                return data['embedding'][:VEC_DIM]
        except Exception:
            pass

    # 最终降级
    print('⚠️  [vector_store] 所有嵌入服务不可用，使用随机向量（检索无意义）')
    vec = np.random.rand(VEC_DIM).astype(np.float32)
    vec = vec / (np.linalg.norm(vec) + 1e-8)
    return vec.tolist()


# ============================================================
# 集合管理
# ============================================================

_collection = None  # 全局单例（模块级缓存）


def get_collection() -> 'zvec.Collection':
    """获取或创建 Zvec Collection（单例）。"""
    global _collection
    if _collection is not None:
        return _collection

    if not ZVEC_AVAILABLE:
        raise RuntimeError('zvec 未安装：pip install zvec')

    schema = _make_schema()
    if os.path.exists(COLLECTION_PATH):
        # 已存在，用 open 模式（避免 create_and_open 的路径冲突）
        _collection = zvec.open(COLLECTION_PATH)
        print(f'✅ [vector_store] 打开已有集合: {COLLECTION_PATH}')
    else:
        # 新建集合
        _collection = zvec.create_and_open(COLLECTION_PATH, schema)
        print(f'✅ [vector_store] 创建新集合: {COLLECTION_PATH}')
    
    return _collection


def store_report(
    title: str,
    topic: str,
    priority: str,
    summary: str,
    embedding_text: Optional[str] = None
) -> str:
    """
    存储一份分析报告到向量数据库。
    
    Args:
        title: 报告标题（主题）
        topic: 主题分类（科技/地缘/经济等）
        priority: 优先级（高/中/低）
        summary: 分析摘要（用于生成嵌入向量）
        embedding_text: 自定义嵌入文本（默认为 summary）
    
    Returns:
        文档ID
    """
    col = get_collection()
    
    # 生成文档ID
    doc_id = f"gi_{int(time.time()*1000)}"
    
    # 嵌入向量
    text_to_embed = embedding_text or summary
    vector = embed_text(text_to_embed)
    if vector is None:
        raise RuntimeError('嵌入生成失败')

    # 确保向量是 list（避免 np.array 的 bool 检查 bug）
    if isinstance(vector, np.ndarray):
        vector = vector.tolist()

    # 创建文档
    doc = zvec.Doc(doc_id)
    doc.fields['id']        = doc_id
    doc.fields['title']      = title
    doc.fields['topic']     = topic
    doc.fields['priority']  = priority
    doc.fields['timestamp'] = time.time()
    doc.fields['summary']   = summary[:2000]  # 限制长度
    doc.vectors['embedding'] = np.array(vector, dtype=np.float32)

    # 插入
    result = col.upsert([doc])
    col.flush()

    print(f'✅ [vector_store] 存储报告: [{doc_id}] {title} ({topic})')
    return doc_id


def search_similar(
    query_text: str,
    topic_filter: Optional[str] = None,
    topk: int = 5
) -> list:
    """
    语义相似度搜索。
    
    Args:
        query_text: 查询文本
        topic_filter: 可选，主题过滤（如 '科技'）
        topk: 返回数量
    
    Returns:
        list of dict: 每项含 {id, title, topic, priority, timestamp, summary, score}
    """
    col = get_collection()
    
    # 生成查询向量
    vector = embed_text(query_text)
    if vector is None:
        return []
    if isinstance(vector, np.ndarray):
        vector = vector.tolist()

    # 构建 filter
    filter_expr = None
    if topic_filter:
        # 安全：只允许英文、数字、中文
        safe_topic = ''.join(c for c in topic_filter if c.isalnum() or c in ('_', '-'))
        filter_expr = f"topic='{safe_topic}'"

    # 查询（传入 list 而非 np.array，避免 bool 检查 bug）
    vq = zvec.VectorQuery('embedding', id=None, vector=vector)
    docs = col.query(
        vectors=[vq],
        topk=topk,
        filter=filter_expr,
        output_fields=['id', 'title', 'topic', 'priority', 'timestamp', 'summary']
    )

    results = []
    for d in docs:
        results.append({
            'id':        d.id,
            'title':     d.fields.get('title', ''),
            'topic':     d.fields.get('topic', ''),
            'priority':  d.fields.get('priority', ''),
            'timestamp': d.fields.get('timestamp', 0),
            'summary':   d.fields.get('summary', ''),
            'score':     d.score if hasattr(d, 'score') and d.score is not None else 0.0,
        })
    
    return results


def build_index() -> bool:
    """为集合构建 HNSW 索引，加速大规模检索。"""
    try:
        col = get_collection()
        col.create_index('embedding', zvec.HnswIndexParam(
            m=16,
            ef_construction=200,
            nthreads=-1
        ))
        print('✅ [vector_store] HNSW 索引构建完成')
        return True
    except Exception as e:
        print(f'⚠️  [vector_store] 索引构建失败: {e}')
        return False


def stats() -> dict:
    """返回集合统计信息。"""
    try:
        col = get_collection()
        # 尝试获取文档数（Collection 可能没有 num_docs 方法）
        if hasattr(col, 'num_docs'):
            n = col.num_docs()
        else:
            # 遍历估计（zvec 没有直接方法）
            n = None
        return {
            'available': True,
            'path': COLLECTION_PATH,
            'dim': VEC_DIM,
            'docs_count': n,
            'embedding_backend': _detect_backend()
        }
    except Exception as e:
        return {'available': False, 'error': str(e)}


def _detect_backend() -> str:
    if os.environ.get('DASHSCOPE_API_KEY'):
        return 'dashscope'
    if os.environ.get('OPENAI_API_KEY'):
        return 'openai'
    mlx = os.path.expanduser('~/.qclaw/workspace/skills/mlx-fallback/scripts/chat.py')
    if os.path.exists(mlx):
        return 'mlx-local'
    return 'random-fallback'


if __name__ == '__main__':
    print('🧪 [vector_store] 集成测试')
    print('=' * 50)
    s = stats()
    print(f'状态: {s}')
    
    if not ZVEC_AVAILABLE:
        print('❌ zvec 未安装，跳过存储测试')
    else:
        # 存储测试
        doc_id = store_report(
            title='中美AI竞争分析',
            topic='科技',
            priority='高',
            summary='基于斯坦福HAI 2026报告，中国在AI领域追赶迅速，差距收窄至2.7%。'
        )
        
        # 搜索测试
        results = search_similar('中国AI发展和美国差距', topk=3)
        print(f'\n🔍 搜索「中国AI发展和美国差距」:')
        for r in results:
            print(f"  [{r['score']:.3f}] {r['title']} | {r['topic']} | {r['summary'][:60]}...")
        
        # 主题过滤测试
        results2 = search_similar('经济制裁影响', topic_filter='科技', topk=3)
        print(f'\n🔍 搜索「经济制裁影响」（topic=科技）:')
        for r in results2:
            print(f"  [{r['score']:.3f}] {r['title']} | {r['topic']}")
        
        print('\n✅ vector_store 集成测试完成')
