{
  "name": "PubMed E-utilities API",
  "description": "NCBI官方免费API，用于检索生物医学文献",
  "base_url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils",
  "rate_limit": "3 requests/second (无API Key) / 10 requests/second (有API Key)",
  "databases": ["pubmed", "medgen", "omim", "gene", "protein"],
  "endpoints": {
    "esearch": {
      "description": "搜索数据库，返回PMID列表",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi",
      "params": {
        "db": "数据库名（pubmed）",
        "term": "搜索词",
        "retmax": "返回数量（默认20，最大10000）",
        "retmode": "json 或 xml",
        "sort": "排序方式（relevance/pub_date）",
        "datetype": "日期类型（pdat/mdate/edat）",
        "mindate": "起始日期 YYYY/MM/DD",
        "maxdate": "结束日期 YYYY/MM/DD"
      },
      "example": "esearch.fcgi?db=pubmed&term=diabetic+retinopathy&retmax=5&retmode=json"
    },
    "efetch": {
      "description": "获取文献详情（标题、摘要、作者等）",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi",
      "params": {
        "db": "pubmed",
        "id": "PMID（逗号分隔，最多200个）",
        "retmode": "xml 或 text",
        "rettype": "abstract 或 full"
      },
      "example": "efetch.fcgi?db=pubmed&id=12345678,23456789&retmode=xml"
    },
    "esummary": {
      "description": "获取文献摘要信息（比efetch快）",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esummary.fcgi",
      "params": {
        "db": "pubmed",
        "id": "PMID列表",
        "retmode": "json"
      }
    },
    "elink": {
      "description": "获取相关文献链接",
      "url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/elink.fcgi",
      "params": {
        "dbfrom": "pubmed",
        "db": "pubmed",
        "id": "PMID",
        "cmd": "neighbor_score"
      }
    }
  },
  "search_syntax": {
    "title": "[Title] 标题搜索",
    "abstract": "[Title/Abstract] 标题或摘要",
    "author": "[Author] 作者",
    "journal": "[Journal] 期刊",
    "year": "[Publication Date] 发表年份",
    "mesh": "[MeSH Terms] 主题词",
    "type": "[Publication Type] 文献类型",
    "examples": [
      "diabetic retinopathy[Title/Abstract]",
      "treatment[Title] AND diabetes[MeSH]",
      "systematic review[Publication Type]",
      "2020:2025[Publication Date]"
    ]
  },
  "use_cases": {
    "查找最新指南": {
      "term": "{疾病名} guideline[Title] OR systematic review[Publication Type]",
      "sort": "pub_date",
      "retmax": 5
    },
    "查找治疗方法证据": {
      "term": "{疾病名} AND {治疗名}[Title/Abstract]",
      "sort": "relevance",
      "retmax": 10
    },
    "查找药物安全性": {
      "term": "{药物名} adverse effects OR safety",
      "sort": "relevance",
      "retmax": 5
    }
  },
  "rate_limit_notice": "无API Key时：每秒最多3次请求，每次最多10000条结果。建议在请求间加延迟300ms。",
  "api_key_info": "可选，注册NCBI账号后获取API Key，可提升至10次/秒。地址：https://www.ncbi.nlm.nih.gov/account/",
  "python_example": "import requests, time\n\ndef search_pubmed(term, retmax=5):\n    url = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/esearch.fcgi'\n    params = {'db': 'pubmed', 'term': term, 'retmax': retmax, 'retmode': 'json'}\n    r = requests.get(url, params=params)\n    return r.json()\n\ndef fetch_abstracts(pmids):\n    url = 'https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi'\n    params = {'db': 'pubmed', 'id': ','.join(pmids), 'retmode': 'xml'}\n    r = requests.get(url, params=params)\n    return r.text"
}
