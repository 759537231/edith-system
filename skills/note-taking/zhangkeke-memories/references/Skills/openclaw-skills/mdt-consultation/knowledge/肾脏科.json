{
  "科室": "肾脏科",
  "版本": "v1.0",
  "更新日期": "2026-04-23",
  "诊断知识": {
    "CKD分期": {
      "标准": "KDIGO 2024",
      "分级": [
        {"分期": "G1", "eGFR": "≥90", "管理": "病因治疗+心血管风险筛查"},
        {"分期": "G2", "eGFR": "60-89", "管理": "病因治疗+每年复查"},
        {"分期": "G3a", "eGFR": "45-59", "管理": "心血管风险评估+肾性贫血筛查"},
        {"分期": "G3b", "eGFR": "30-44", "管理": "CKD-MBD管理+准备替代治疗"},
        {"分期": "G4", "eGFR": "15-29", "管理": "肾脏替代治疗准备+转诊"},
        {"分期": "G5", "eGFR": "<15", "管理": "透析/移植"}
      ]
    },
    "AKI": {
      "诊断标准": "48h内eGFR升高≥26.5μmol/L 或 7天内升高≥1.5倍 或 尿量<0.5ml/kg/h×6h",
      "KDIGO分期": [
        {"分期": "1期", "肌酐升高": "1.0-1.5倍或↑≥26.5"},
        {"分期": "2期", "肌酐升高": "1.5-2.0倍"},
        {"分期": "3期", "肌酐升高": "2.0-3.0倍或≥353.6"}
      ],
      "病因分类": {
        "肾前性": "灌注不足（脱水/出血/心衰）→ 补液试验后改善",
        "肾性": "ATN（缺血/肾毒性）/AIN（药物过敏）/ 急性肾小球肾炎",
        "肾后性": "梗阻（结石/肿瘤/前列腺）→ 超声可确诊"
      }
    },
    "心肾综合征": {
      "定义": "心功能与肾功能相互恶化",
      "分型": [
        {"分型": "1型", "描述": "急性心衰→AKI（最常见）"},
        {"分型": "2型", "描述": "慢性心衰→CKD进展"},
        {"分型": "3型", "描述": "AKI→急性心衰"},
        {"分型": "4型", "描述": "CKD→心功能下降"}
      ],
      "管理要点": "避免肾毒性药物，液体平衡管理，利尿剂剂量需肾脏科确认"
    },
    "药物与肾功能": {
      "利尿剂选择": {
        "eGFR≥30": "氢氯噻嗪可用",
        "eGFR<30": "氢氯噻嗪基本无效，换呋塞米",
        "eGFR<30+螺内酯": "高钾风险↑，避免联用或密切监测"
      },
      "造影剂肾病预防": {
        "高风险": "eGFR<30",
        "措施": ["造影前48h停二甲双胍", "水化（造影前后各500ml NS/h）", "造影后48h复查肾功能"]
      },
      "SGLT2抑制剂肾功能边界": {
        "达格列净": "eGFR≥45正常使用，30-44慎用，<30停用",
        "恩格列净": "eGFR≥45正常使用，<30停用"
      }
    },
    "肾性贫血": {
      "诊断": "Hb<110g/L（排除其他原因）",
      "检查": "铁代谢+网织红+B12+叶酸",
      "治疗": "补铁→ESA（EPO）→罗沙司他"
    },
    "CKD-MBD": {
      "表现": "钙磷代谢紊乱+继发性甲旁亢+血管钙化",
      "检查": "Ca/P/PTH/25(OH)D/ALP",
      "管理": "控制血磷+活性VD+拟钙剂"
    }
  },
  "证据来源": ["KDIGO CKD评估与管理指南2012/2024更新", "KDIGO AKI指南2012", "KDIGO心肾综合征共识2023"]
}
