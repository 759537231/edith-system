        {"分级": "III级", "描述": "体力活动明显受限"},
        {"分级": "IV级", "描述": "休息时也有症状"}
      ],
      "关键用药注意": {
        "呋塞米": "排Na+排K+，注意补钾，监测电解质",
        "螺内酯": "保钾利尿，eGFR<30慎用/禁用，防高钾",
        "SGLT2i": "达格列净/恩格列净eGFR<20停用",
        "ACEI/ARB": "起始低剂量逐步加量，监测血钾和肾功能"
