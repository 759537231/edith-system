        "表现": "胸痛+ST压低/T波倒置+心肌酶升高",
        "处理": "危险分层→早期介入"
      },
      "不稳定心绞痛": {
        "表现": "新发/加重/静息发作的胸痛，心肌酶正常"
      }
    },
