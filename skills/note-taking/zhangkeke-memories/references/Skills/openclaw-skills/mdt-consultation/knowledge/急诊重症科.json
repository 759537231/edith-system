{
  "科室": "急诊/重症科",
  "版本": "v1.0",
  "更新日期": "2026-04-23",
  "诊断知识": {
    "生命体征危急值": [
      {"指标": "心率", "危急低": "<40", "危急高": ">180", "处理": "阿托品/起搏 / 评估心律"},
      {"指标": "SBP", "危急低": "<70", "危急高": ">220", "处理": "升压/输液 / 降压"},
      {"指标": "SpO2", "危急低": "<90%", "处理": "氧疗/通气支持"},
      {"指标": "体温", "危急高": ">41°C", "处理": "物理降温+药物降温"},
      {"指标": "GCS", "危急低": "≤8", "处理": "气道保护+评估昏迷原因"}
    ],
    "休克四型": {
      "低血容量性": {
        "特征": "CVP↓/心排量↓/SVR↑，皮肤冷湿花斑",
        "处理": "补液（晶体首选30ml/kg），出血→止血+输血"
      },
      "心源性": {
        "特征": "CVP↑/心排量↓/SVR↑，颈静脉怒张",
        "处理": "正性肌力药（多巴酚丁胺），心梗→PCI"
      },
      "分布性_脓毒性": {
        "特征": "CVP↓或正常/心排量↑或正常/SVR↓，暖休克",
        "处理": "液体复苏+血管活性药（去甲肾）+抗菌药（1h内）"
      },
      "梗阻性": {
        "特征": "CVP↑/心排量↓/SVR↑，张力性气胸/心包填塞/肺栓塞",
        "处理": "解除梗阻（引流/溶栓/手术）"
      }
    },
    "心脏骤停": {
      "识别": "无反应+无呼吸或濒死喘息",
      "流程": "呼救→CPR（30:2）→AED/除颤→ALS",
      "可除颤心律": "室颤/无脉性室速",
      "不可除颤心律": "心电静止/PEA"
    },
    "急性肺栓塞": {
      "高危征象": ["突发呼吸困难", "胸痛（胸膜性）", "SpO2↓", "D-二聚体↑", "右心负荷增加（心电图S1Q3T3）"],
      "危险分层": {
        "高危": "血流动力学不稳定→溶栓",
        "中危": "右心功能不全→抗凝",
        "低危": "无右心负荷→抗凝"
      }
    },
    "谵妄评估": {
      "CAM-ICU快速筛查": [
        "①意识状态急性改变/波动",
        "②注意力不集中",
        "③思维混乱",
        "④意识水平改变（清醒以外的状态）"
      ],
      "阳性": "①+②+③或④ → 谵妄"
    },
    "脓毒症集束化": {
      "1h内": ["测乳酸", "血培养（抗生素前）", "广谱抗生素", "低血压→晶体液30ml/kg"],
      "3h内": ["复查乳酸", "液体复苏评估", "必要时用血管活性药"]
    }
  },
  "证据来源": ["AHA ACLS指南", "Surviving Sepsis Campaign 2021", "中国脓毒症急诊诊治指南2019", "ESC急性肺栓塞指南2019"]
}
