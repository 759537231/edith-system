{
  "name": "OpenFDA API",
  "description": "美国FDA开放数据API，包含药物不良事件、标签、召回等",
  "base_url": "https://api.fda.gov",
  "rate_limit": "240 requests/minute (无API Key) / 1200 requests/minute (有API Key)",
  "databases": {
    "drug/event": "药物不良事件报告（FAERS）",
    "drug/label": "药物标签信息",
    "drug/enforcement": "药物召回信息",
    "device/event": "医疗器械不良事件",
    "food/enforcement": "食品召回信息"
  },
  "endpoints": {
    "search": {
      "description": "搜索数据库",
      "url": "https://api.fda.gov/{database}/search",
      "params": {
        "search": "搜索条件",
        "limit": "返回数量（默认1，最大100）",
        "skip": "跳过数量（分页）"
      },
      "example": "drug/event.json?search=patient.drug.medicinalproduct:metformin&limit=10"
    }
  },
  "search_syntax": {
    "field:value": "字段搜索，如 patient.drug.medicinalproduct:aspirin",
    "AND": "与条件，如 field1:value1+AND+field2:value2",
    "OR": "或条件，如 field1:value1+OR+field2:value2",
    "NOT": "非条件，如 NOT field:value",
    "[TO]": "范围，如 receivedate:[20200101 TO 20251231]"
  },
  "use_cases": {
    "查询药物不良事件": {
      "url": "drug/event.json",
      "search": "patient.drug.medicinalproduct:{药物名}",
      "limit": 20
    },
    "查询药物标签": {
      "url": "drug/label.json",
      "search": "openfda.brand_name:{品牌名}",
      "limit": 1
    },
    "查询药物召回": {
      "url": "drug/enforcement.json",
      "search": "product_description:{药物名}",
      "limit": 10
    }
  },
  "python_example": "import requests\n\ndef search_adverse_events(drug_name, limit=10):\n    url = f'https://api.fda.gov/drug/event.json'\n    params = {'search': f'patient.drug.medicinalproduct:{drug_name}', 'limit': limit}\n    r = requests.get(url, params=params, timeout=10)\n    return r.json()\n\ndef get_drug_label(brand_name):\n    url = 'https://api.fda.gov/drug/label.json'\n    params = {'search': f'openfda.brand_name:{brand_name}', 'limit': 1}\n    r = requests.get(url, params=params, timeout=10)\n    return r.json()"
}
