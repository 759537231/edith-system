{
  "description": "证据等级定义及来源",
  "等级": {
    "A": {
      "定义": "高质量证据",
      "来源": [
        "随机对照试验(RCT)的系统综述/Meta分析",
        "高质量RCT（低偏倚风险）"
      ],
      "国际指南": [
        "WHO指南",
        "美国AAO指南",
        "英国NICE指南"
      ],
      "示例": "抗VEGF药物治疗湿性黄斑变性的多项RCT汇总"
    },
    "B": {
      "定义": "中等质量证据",
      "来源": [
        "队列研究",
        "病例对照研究",
        "低质量RCT"
      ],
      "国际指南": [
        "AAN实践指南",
        "中国中华医学会指南（循证）"
      ],
      "示例": "阿司匹林预防心脑血管事件的队列研究"
    },
    "C": {
      "定义": "低质量证据",
      "来源": [
        "专家共识",
        "病例系列",
        "专家意见",
        "临床经验"
      ],
      "国际指南": [
        "专家共识文件",
        "临床路径",
        "教科书"
      ],
      "示例": "某中药方剂的专家共识"
    },
    "D": {
      "定义": "极低质量证据",
      "来源": [
        "个案报告",
        "传统理论",
        "未经验证的经验"
      ],
      "国际指南": [],
      "示例": "中医古籍中的经验方"
    }
  },
  "使用原则": [
    "A/B级证据可直接引用",
    "C级证据需标注'专家共识'",
    "D级证据需标注'传统经验，需验证'",
    "药物推荐至少需要C级证据"
  ]
}
