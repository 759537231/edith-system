{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MDT Expert Communication Protocol",
  "description": "多学科会诊专家间交流协议（13科版）。各科输出格式见对应角色卡roles/*.md，本协议仅定义科间通信格式",
  "type": "object",
  "required": ["round", "from", "to", "type", "content"],
  "definitions": {
    "evidence_level": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "A=系统综述/Meta, B=队列研究, C=专家共识, D=传统理论"
    },
    "priority": {
      "type": "string",
      "enum": ["高", "中", "低"]
    },
    "department": {
      "type": "string",
      "enum": ["眼科", "神经科", "神经眼科", "康复科", "心理科", "中医", "心脏科", "呼吸科", "肾脏科", "急诊重症科", "内分泌科", "营养科", "运动医学科"],
      "description": "十三大学科"
    }
  },
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "description": "交流轮次，最多3轮"
    },
    "from": {
      "$ref": "#/definitions/department"
    },
    "to": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/department"
      },
      "minItems": 1,
      "description": "接收方，可多个"
    },
    "type": {
      "type": "string",
      "enum": ["初诊", "回应", "追问", "共识", "分歧"],
      "description": "交流类型"
    },
    "content": {
      "type": "string",
      "description": "具体内容，引用各科输出中的diagnoses/treatment_plan关键字段",
      "maxLength": 500
    },
    "evidence": {
      "type": "string",
      "description": "证据描述"
    },
    "evidence_level": {
      "$ref": "#/definitions/evidence_level"
    },
    "clinical_significance": {
      "type": "string",
      "description": "临床意义说明"
    },
    "change_original": {
      "type": "boolean",
      "description": "是否改变原诊断"
    },
    "supplement_diagnosis": {
      "type": "array",
      "items": { "type": "string" },
      "description": "补充诊断"
    },
    "suggested_action": {
      "type": "array",
      "items": { "type": "string" },
      "description": "建议行动"
    },
    "priority": {
      "$ref": "#/definitions/priority"
    },
    "need_response": {
      "type": "boolean",
      "description": "是否需要对方回应"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
