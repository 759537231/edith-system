{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MDT Consultation Case Schema",
  "description": "联合会诊病例结构化数据标准",
  "type": "object",
  "required": ["case_id", "采集时间", "患者自述"],
  "properties": {
    "case_id": {
      "type": "string",
      "description": "病例唯一标识，格式：mdt-YYYYMMDD-NNN",
      "pattern": "^mdt-\\d{8}-\\d{3}$"
    },
    "采集时间": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 格式，带时区"
    },
    "患者自述": {
      "type": "object",
      "required": ["主诉"],
      "properties": {
        "基本信息": {
          "type": "object",
          "properties": {
            "性别": { "type": "string" },
            "年龄": { "type": "integer" },
            "职业": { "type": "string" },
            "身高(cm)": { "type": "number", "minimum": 50, "maximum": 250 },
            "体重(kg)": { "type": "number", "minimum": 10, "maximum": 300 },
            "BMI": { "type": "number", "minimum": 10, "maximum": 80, "description": "自动计算，体重(kg)/身高(m)²" }
          }
        },
        "主诉": {
          "type": "string",
          "description": "患者最主要的不适，一句话概括",
          "maxLength": 100
        },
        "现病史": {
          "type": "object",
          "properties": {
            "症状": {
              "type": "array",
              "items": { "type": "string" },
              "description": "主要症状列表"
            },
            "起病时间": {
              "type": "string",
              "format": "date",
              "description": "症状开始日期"
            },
            "持续时间": {
              "type": "string",
              "description": "如：3天、2周、反复发作1年"
            },
            "加重因素": {
              "type": "array",
              "items": { "type": "string" },
              "description": "使症状加重的因素"
            },
            "缓解因素": {
              "type": "array",
              "items": { "type": "string" },
              "description": "使症状缓解的因素"
            },
            "伴随症状": {
              "type": "array",
              "items": { "type": "string" },
              "description": "伴随主症出现的其他症状"
            }
          }
        },
        "既往史": {
          "type": "array",
          "items": { "type": "string" },
          "description": "既往疾病、手术史"
        },
        "用药史": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "药物": { "type": "string" },
              "剂量": { "type": "string" },
              "频次": { "type": "string" },
              "效果": { "type": "string", "enum": ["有效", "无效", "不明", "部分有效", "副作用停药", "目前服用中"] }
            }
          }
        },
        "检查报告": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["类型", "结果"],
            "properties": {
              "类型": {
                "type": "string",
                "enum": ["眼底照相", "OCT", "OCT-RNFL", "视野", "VEP", "微视野", "多焦ERG", "ERG", "对比敏感度", "眼压", "验光", "瞳孔检查", "CT", "MRI", "MRA", "MRV", "DWI", "脑电图", "心理量表", "血液检查", "腰穿", "体脂率", "心肺运动试验", "甲功", "糖化血红蛋白", "OGTT", "胰岛素释放试验", "性激素六项", "骨密度", "血常规", "肝功能", "肾功能", "血脂四项", "尿常规", "皮质醇", "腹部超声", "心电图", "其他"]
              },
              "结果": { "type": "string" },
              "日期": { "type": "string", "format": "date" },
              "医院": { "type": "string" }
            }
          }
        },
        "过敏史": {
          "type": "array",
          "items": { "type": "string" }
        },
        "家族史": {
          "type": "array",
          "items": { "type": "string" },
          "description": "遗传性疾病或类似症状家族史"
        }
      }
    },
    "医导标注": {
      "type": "object",
      "properties": {
        "跨学科线索": {
          "type": "array",
          "items": { "type": "string" },
          "description": "提示需要多科会诊的线索"
        },
        "紧急程度": {
          "type": "string",
          "enum": ["高", "中", "低"],
          "description": "医导判断的紧急程度"
        },
        "建议会诊方向": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["眼科", "神经科", "神经眼科", "康复科", "心理科", "中医", "心脏科", "呼吸科", "肾脏科", "急诊重症科", "内分泌科", "营养科", "运动医学科"]
          }
        },
        "采集轮数": {
          "type": "integer",
          "description": "医导对话轮数"
        },
        "备注": {
          "type": "string",
          "description": "医导观察到的其他信息，如情绪状态"
        }
      }
    }
  }
}
